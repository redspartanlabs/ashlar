{
  "name": "ashlar",
  "version": "0.1.0",
  "private": true,
  "description": "Tailwind tooling for the Ashlar showcase application",
  "type": "commonjs",
  "scripts": {
    "build:css": "tailwindcss -i ./showcase/src/main/tailwind/app.css -o ./showcase/src/main/resources/static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./showcase/src/main/tailwind/app.css -o ./showcase/src/main/resources/static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
